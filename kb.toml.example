# Local KB configuration — example.
#
# Copy this file to kb.toml and edit that copy:
#
#     cp kb.toml.example kb.toml
#
# kb.toml is gitignored, so your own hosts, model tags and tuning stay on your
# machine and never reach the repo. Every value here is optional — delete any
# line to fall back to its built-in default, or skip the file entirely.

[model]
default = "qwen3.6-35b-a3b"

[llamacpp]
host = "127.0.0.1"
chat_port = 8080           # local chat server (start-llm.py or llama-swap)
embed_port = 11434         # Ollama (serves nomic-embed-text via OpenAI-compat /v1/embeddings)
timeout = 1200             # seconds per LLM call
# Tag dropdown shown in the UI sidebar. Bundled tags work with start-llm.py;
# advanced users can also add aliases configured in llama-swap.
models = [
  "qwen3.6-35b-a3b",      # bundled start-llm.py default: Qwen3.6 35B-A3B MoE (256K ctx)
  "gemma4-e2b",           # bundled start-llm.py fallback: smaller Gemma model
  "qwen3.6-27b",          # qwen3.6-27b-256k (full 256K, text-only)
  "qwopus:3.6-35b-A3B-v1", # qwopus3.6-35b-a3b (MoE + vision)
  "gemma4:e4b",           # gemma4-e4b (+ vision)
]

[llamacpp_remote]
host = "127.0.0.1"
chat_port = 8080           # llama-swap-remote
timeout = 1200
# Optional remote aliases; customize for your environment.
models = [
  "deepseek-v4-flash",    # DeepSeek V4 Flash (512K ctx)
  "qwen3.6-35b-a3b",      # Qwen3.6 35B-A3B MoE (256K ctx)
]

[compile]
temperature = 0.2
max_source_chars = 524288  # chars sent to the LLM per source doc
related_pages_top_k = 5    # how many similar existing wiki pages to feed into the compile prompt

[ask]
temperature = 0.1
context_per_page = 30000  # chars loaded per wiki page
default_limit = 6         # number of wiki pages to include

[ingest]
max_content_chars = 120000  # URL / non-PDF content truncation limit

[faiss]
embed_model = "nomic-embed-text:latest"
chunk_size = 1200           # characters per chunk
chunk_overlap = 200         # overlap between consecutive chunks
context_budget = 200000     # max total chars assembled for LLM prompt
top_k = 50                  # max chunks to retrieve from FAISS
enabled = true              # set false to always use TF-IDF

[graph]
# Semantic edges in the Explore graph view. Each page keeps its top-k nearest
# neighbours; an edge is drawn only where two pages pick each other, which is
# what stops broad pages from becoming hubs. Raise for a denser graph.
similar_top_k = 5
similar_min_score = 0.5     # discard matches weaker than this cosine score
